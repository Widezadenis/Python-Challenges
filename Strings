If zipcode has four characters and the first character is '0', the function must return 'Invalid ZIP Code.'.

def zip_checker(zipcode): # defines function 
    if len(zipcode) == 5: #creates if statement to check if the zipcode has five characters, and the first two characters are NOT '00'
        if zipcode[:2] != '00':
            return(str(zipcode))
            
    elif len(zipcode) == 4: # checks for four characters and the first character is not 0
        if zipcode[0] != '0':
            return '0' + zipcode
        
        else:
